# Settings for `docker compose` (copy to .env). Empty means "not set".

# Management token: protects /login, /logout and /api and signs in to the
# panel. Required for public mode. Generate one with: openssl rand -hex 24
WRAPPER_API_TOKEN=

# Image tag: latest (newest release), nightly (newest commit) or a version.
WRAPPER_TAG=latest

# Where account data is kept on the host (logins, sessions, statistics,
# settings). Back it up, or use Backup in the panel.
WRAPPER_DATA_DIR=./rootfs/data

# Host address and port of the panel + API. 127.0.0.1 keeps it local (for
# example behind a reverse proxy on the same machine).
WRAPPER_BIND=0.0.0.0
WRAPPER_HOST_PORT=12340

# Public mode: anyone who opens the address may add their own account.
WRAPPER_PUBLIC=false
# Most active accounts public mode accepts (0: no limit). Saved; can also be
# changed in the panel under Public mode.
WRAPPER_MAX_ACCOUNTS=

# Proxy for lite and Apple catalog lookups, e.g. http://192.168.1.2:7890 or
# socks5://192.168.1.2:1080.
WRAPPER_PROXY=

# Agent log level: trace, debug, info, warn, error.
WRAPPER_LOG=info
